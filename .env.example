DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OPENAI_API_KEY=
PORT=3210
TRANSCRIBE_MODEL=gpt-live-transcribe
TRANSCRIBE_DELAY=medium
# Comma-separated proper nouns. Do not include angle brackets.
TRANSCRIBE_KEYWORDS=Discord
TRANSLATION_MODEL=gpt-4.1-mini
TRANSLATION_ENABLED=true
# Split long utterances so English follows without waiting for a long silence.
MAX_TURN_MS=8000
SILENCE_MS=700
MAX_SPEAKERS=10
