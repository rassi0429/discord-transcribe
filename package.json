{
  "name": "discord-transcribe",
  "version": "0.1.0",
  "description": "Discord voice captions with per-user Japanese transcription and English translation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rassi0429/discord-transcribe.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "register": "node --env-file-if-exists=.env src/register.js",
    "test": "node --test test/*.test.js",
    "test:simulation": "node scripts/test-simulation.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "linkedom": "^0.18.13"
  }
}
